  }

  .market-product-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--yidian-market-line);
    border-radius: 8px;
    background: var(--yidian-market-panel);
    color: var(--yidian-market-text);
    transition: border-color 0.16s;
  }

  .market-product-card:hover {
    border-color: var(--yidian-market-accent);
  }

  .market-product-card[hidden] {
