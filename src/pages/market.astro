<Layout metadata={metadata}>
  <section class="market-section" aria-labelledby="marketHeading">
    <div class="market-container">
      <div class="market-console">
        <div>
          <p class="market-kicker">Storefront</p>
          <strong id="marketHeading">选择服务类型</strong>
        </div>

        <div class="market-filters" role="group" aria-label="商品分类">
          {
            categories.map((category, index) => (
              <button
                type="button"
                class:list={{ active: index === 0 }}
                data-market-filter={category}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {category}
              </button>
            ))
          }
        </div>

        <span class="market-count" data-market-count>{products.length} 件在售商品</span>
      </div>

      <div class="market-product-grid" data-market-grid>
        {
          products.map((product, index) => (
            <article
              class="market-product-card"
              data-market-product
              data-product-id={product.id}
              data-category={product.category}
              data-title={product.title}
              data-summary={product.summary}
              data-dialog-title={product.dialogTitle}
              data-dialog-summary={product.dialogSummary}
              data-description={product.description}
              data-price={product.price}
              data-original-price={product.originalPrice}
              data-sold={String(product.sold)}
              data-stock={String(product.stock)}
              data-commission={product.commission}
              data-href={product.href}
            >
              <div class="market-product-cover">
                <Image
                  src={product.cover}
                  alt={`${product.title} 商品封面`}
                  class="market-product-image"
                  widths={[768, 1536]}
                  sizes="(max-width: 680px) calc(100vw - 30px), 384px"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              </div>

              <div class="market-product-body">
                <span class="market-product-category">{product.category}</span>
                <h2>{product.title}</h2>
                <p>{product.summary}</p>

                <div class="market-product-bottom">
                  <div class="market-product-price">
                    <strong>{product.price}</strong>
                    <del>{product.originalPrice}</del>
                  </div>
                  <span>
                    已售出 {product.sold} · 库存 {product.stock}
                  </span>
                </div>

                <button type="button" data-product-open={product.id}>
                  查看详情
                  <Icon name="tabler:arrow-up-right" />
                </button>
              </div>
            </article>
          ))
        }
      </div>

      <div class="market-empty-state" data-market-empty hidden>
        <Icon name="tabler:building-store" />
        <strong>暂时没有可购买的商品</strong>
        <span>管理员发布商品后会在这里出现。</span>
      </div>
    </div>
  </section>

  <dialog id="productDialog" class="market-dialog product-dialog" aria-labelledby="productDialogTitle">
    <button type="button" class="market-dialog-close" data-dialog-close aria-label="关闭">
      <Icon name="tabler:x" />
    </button>
    <div class="product-dialog-cover" data-dialog-cover></div>
    <p class="market-kicker" data-dialog-category></p>
    <h2 id="productDialogTitle" data-dialog-title></h2>
    <p class="product-dialog-summary" data-dialog-summary></p>
    <div class="product-dialog-price">
      <strong data-dialog-price></strong>
      <span data-dialog-meta></span>
    </div>
    <div class="product-dialog-description" data-dialog-description></div>
    <div class="product-dialog-actions">
      <button type="button" class="market-button primary" data-order-open>点击联系客服下单</button>
    </div>
  </dialog>

  <dialog id="orderDialog" class="market-dialog contact-dialog" aria-label="联系客服下单">
    <button type="button" class="market-dialog-close" data-dialog-close aria-label="关闭">
      <Icon name="tabler:x" />
    </button>
    <Image
      src={wecomQrCode}
      alt="企业微信二维码，扫码联系客服下单"
      class="contact-qr-code"
      widths={[280, 560]}
      sizes="280px"
    />
  </dialog>
</Layout>

<script>
  function initializeMarketPage() {
    const marketGrid = document.querySelector<HTMLElement>('[data-market-grid]');
    if (!marketGrid || marketGrid.dataset.marketInitialized === 'true') return;
    marketGrid.dataset.marketInitialized = 'true';

    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-market-product]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-market-filter]'));
    const count = document.querySelector<HTMLElement>('[data-market-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-market-empty]');
    const productDialog = document.querySelector<HTMLDialogElement>('#productDialog');
    const orderDialog = document.querySelector<HTMLDialogElement>('#orderDialog');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.marketFilter || '全部';
        let visibleCount = 0;

        cards.forEach((card) => {
          const visible = category === '全部' || card.dataset.category === category;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (count) count.textContent = `${visibleCount} 件在售商品`;
        marketGrid.hidden = visibleCount === 0;
        if (emptyState) emptyState.hidden = visibleCount !== 0;
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-product-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const id = button.dataset.productOpen || '';
        const card = cards.find((item) => item.dataset.productId === id);
        if (!card || !productDialog) return;

        const setText = (selector: string, value = '') => {
          const element = productDialog.querySelector<HTMLElement>(selector);
          if (element) element.textContent = value;
        };

        setText('[data-dialog-category]', card.dataset.category);
        setText('[data-dialog-title]', card.dataset.dialogTitle);
        setText('[data-dialog-summary]', card.dataset.dialogSummary);
        setText('[data-dialog-price]', card.dataset.price);
        setText('[data-dialog-meta]', `已售出 ${card.dataset.sold} · 当前库存 ${card.dataset.stock}`);
        setText('[data-dialog-description]', card.dataset.description);

        const coverTarget = productDialog.querySelector<HTMLElement>('[data-dialog-cover]');
        const cover = card.querySelector<HTMLImageElement>('.market-product-image');
        if (coverTarget && cover) {
          const clonedImage = cover.cloneNode(true) as HTMLImageElement;
          clonedImage.sizes = '680px';
          coverTarget.replaceChildren(clonedImage);
        }

        productDialog.showModal();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-dialog-close]').forEach((button) => {
      button.addEventListener('click', () => button.closest<HTMLDialogElement>('dialog')?.close());
    });

    document.querySelector<HTMLButtonElement>('[data-order-open]')?.addEventListener('click', () => {
      if (!orderDialog) return;

      productDialog?.close();
      orderDialog.showModal();
    });

    [productDialog, orderDialog].forEach((dialog) => {
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  initializeMarketPage();
  document.addEventListener('astro:page-load', initializeMarketPage);
</script>

<style>
