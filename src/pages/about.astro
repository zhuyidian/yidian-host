---
import { Image } from 'astro:assets';

import Layout from '~/layouts/PageLayout.astro';
import wechatQrCode from '~/assets/images/footer/wechat-qrcode.webp';
import wecomQrCode from '~/assets/images/footer/wecom-qr.webp';

const metadata = {
  title: '关于',
  description: 'YidianHub 的服务、文章与日常资源空间说明。',
};

const contactCards = [
  {
    title: '企业微信',
    scanText: '扫码添加企业微信',
    description: '用于咨询服务、沟通需求和获取支持。',
    image: wecomQrCode,
    alt: '企业微信二维码，扫码添加企业微信',
  },
  {
    title: '微信公众号',
    scanText: '扫码关注微信公众号',
    description: '获取最新、最全的文章内容，定期推送 AI 相关文章与实用资讯。',
    image: wechatQrCode,
    alt: '微信公众号二维码，扫码关注微信公众号',
  },
];

const serviceStatus = [
  { label: 'API 服务', value: '已启用' },
  { label: '文章空间', value: '已启用' },
  { label: '常用工具', value: '持续整理' },
  { label: '联系支持', value: '企业微信可用' },
];
---

<Layout metadata={metadata}>
  <section class="about-section" aria-labelledby="aboutHeading">
    <div class="about-container">
      <header class="about-intro">
        <p class="about-kicker">About</p>
        <h1 id="aboutHeading">关于 YidianHub</h1>
        <p class="about-subtitle">一个让服务、文章与实用资源保持清楚的独立空间。</p>
      </header>

      <p class="about-lead">
        YidianHub
        不试图把所有信息堆进同一个页面。它更接近一张持续整理的工作台：需要服务时可以直接抵达，需要说明时可以回到文章，需要资源时也能快速找到明确的入口。
      </p>

      <div class="about-principles">
        {
          contactCards.map((card) => (
            <article class="about-principle">
              <h2>{card.title}</h2>
              <p class="about-principle-scan">{card.scanText}</p>
              <p class="about-principle-detail">{card.description}</p>
              <Image
                src={card.image}
                alt={card.alt}
                class="about-principle-qr"
                widths={[220, 440]}
                sizes="(max-width: 680px) 200px, 220px"
              />
            </article>
          ))
        }
      </div>

      <div class="about-divider"></div>

      <section class="about-status" aria-labelledby="statusHeading">
        <div>
          <p class="about-kicker">Service Status</p>
          <h2 id="statusHeading">当前服务范围</h2>
        </div>

        <dl>
          {
            serviceStatus.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </section>
</Layout>

<style>
  .about-section {
    border-bottom: 1px solid var(--yidian-market-line);
    background: var(--yidian-market-bg);
    color: var(--yidian-market-text);
    font-size: 16px;
    line-height: normal;
    padding: 80px 0;
  }

  .about-container {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .about-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--yidian-market-accent);
    font-size: 12px;
    font-weight: 800;
    line-height: 15px;
    text-transform: uppercase;
  }

  .about-kicker::before {
    width: 23px;
    height: 1px;
    background: currentcolor;
    content: '';
  }

  .about-intro h1 {
    margin: 14px 0 6px;
    color: var(--yidian-market-text);
    font-family: var(--aw-font-heading);
    font-size: 42px;
    font-weight: 700;
    line-height: 1.25;
  }

  .about-subtitle {
    margin: 0;
    color: var(--yidian-market-muted);
    font-size: 16px;
    line-height: 22px;
  }

  .about-lead {
    max-width: 880px;
    margin: 126px auto 0;
    color: var(--yidian-market-text);
    font-family: var(--aw-font-heading);
    font-size: 28px;
    font-weight: 500;
    line-height: 1.72;
  }

  .about-principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 56px;
  }

  .about-principle {
    display: flex;
    min-height: 356px;
    flex-direction: column;
    align-items: center;
    padding: 28px;
    border: 1px solid var(--yidian-market-line);
    border-radius: 8px;
    background: var(--yidian-market-panel);
    text-align: center;
  }

  .about-principle h2 {
    margin: 0;
    color: var(--yidian-market-text);
    font-family: var(--aw-font-heading);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
  }

  .about-principle-scan {
    margin: 7px 0 0;
    color: var(--yidian-market-muted);
    font-size: 14px;
    line-height: 20px;
  }

  .about-principle-detail {
    max-width: 420px;
    margin: 2px 0 0;
    color: var(--yidian-market-muted);
    font-size: 13px;
    line-height: 18px;
  }

  :global(.about-principle-qr) {
    display: block;
    width: min(100%, 220px);
    height: 220px;
    margin-top: auto;
    object-fit: contain;
  }

  .about-divider {
    height: 1px;
    margin: 72px 0 50px;
    background: var(--yidian-market-line);
  }

  .about-status {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 80px;
  }

  .about-status h2 {
    margin: 10px 0 0;
    color: var(--yidian-market-text);
    font-family: var(--aw-font-heading);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.3;
  }

  .about-status dl {
    margin: 0;
    border-top: 1px solid var(--yidian-market-line);
  }

  .about-status dl > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 45px;
    border-bottom: 1px solid var(--yidian-market-line);
  }

  .about-status dt,
  .about-status dd {
    margin: 0;
    font-size: 15px;
    line-height: 20px;
  }

  .about-status dt {
    color: var(--yidian-market-muted);
  }

  .about-status dd {
    color: var(--yidian-market-accent);
    font-weight: 700;
    text-align: right;
  }

  @media (max-width: 680px) {
    .about-section {
      padding: 54px 0 62px;
    }

    .about-container {
      width: min(1180px, calc(100% - 28px));
    }

    .about-intro h1 {
      font-size: 34px;
    }

    .about-subtitle {
      font-size: 15px;
    }

    .about-lead {
      margin-top: 68px;
      font-size: 23px;
      line-height: 1.65;
    }

    .about-principles {
      grid-template-columns: 1fr;
      margin-top: 44px;
    }

    .about-principle {
      min-height: 356px;
      padding: 24px;
    }

    .about-principle h2 {
      font-size: 22px;
    }

    :global(.about-principle-qr) {
      width: min(100%, 200px);
      height: 200px;
    }

    .about-divider {
      margin: 54px 0 36px;
    }

    .about-status {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .about-status h2 {
      font-size: 27px;
    }
  }
</style>
