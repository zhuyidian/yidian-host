---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import workspaceImage from '~/assets/images/yidianhub-workspace-v2.jpg';
import { getArticleOverview } from '~/utils/articles';

const metadata = {
  title: 'YidianHub',
  description: '服务入口、文章与实用资源的独立空间。',
  ignoreTitleTemplate: true,
};

const { latest: latestWriting, total: articleTotal } = await getArticleOverview();

const siteStats = [
  { value: '8', label: '个商品' },
  { value: String(articleTotal), label: '篇文章' },
  { value: '1', label: '个工具' },
  { value: '42', label: '个模型' },
];

const apiHighlights = [
  {
    value: '42',
    title: '可用模型',
    detail: '根据当前任务选择所需的模型能力。',
  },
  {
    value: '统一',
    title: '调用入口',
    detail: '在同一服务地址中完成日常模型调用。',
  },
  {
    value: '直接',
    title: '接入工作流',
    detail: '为应用、脚本与自动化场景提供直接接入。',
  },
];
---

<Layout metadata={metadata}>
  <section
    class="yidian-hero relative isolate min-h-[511px] overflow-hidden border-b border-[#333a35] bg-[#10110f] md:min-h-[591px]"
  >
    <Image
      src={workspaceImage}
      alt="夜间工作台上的笔记本电脑与台灯"
      class="yidian-hero-media absolute inset-0 z-0 h-full w-full object-cover object-center opacity-[0.88]"
      widths={[960, 1440, 1800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 z-[5] bg-[linear-gradient(90deg,rgba(16,17,15,0.82)_0%,rgba(16,17,15,0.58)_34%,rgba(16,17,15,0.16)_66%,rgba(16,17,15,0)_84%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative z-10 mx-auto flex min-h-[510px] max-w-[1180px] flex-col items-start justify-end px-[14px] pb-[42px] pt-[72px] md:min-h-[590px] md:justify-center md:px-0 md:py-[72px]"
    >
      <p class="m-0 flex w-fit items-center gap-[9px] text-[12px] font-[800] leading-[15px] text-primary">
        <span class="h-px w-[24px] bg-primary"></span>
        服务入口 · 长文阅读 · 资源沉淀
      </p>
      <h1
        class="mb-[20px] mt-[16px] w-fit max-w-[650px] font-heading text-[38px] font-bold leading-[45.6px] text-[#f5f7f3] md:mt-[22px] md:text-[54px] md:leading-[64.8px]"
      >
        让服务即刻抵达，<br />让内容长久留存。
      </h1>
      <p class="m-0 max-w-[570px] text-[15px] leading-[27px] text-[#c4cbc2] md:text-[17px] md:leading-[30.6px]">
        YidianHub 将服务、文章与日常资源放在同一条清晰路径上。没有多余干扰，打开后直接抵达正在需要的内容。
      </p>
      <dl
        class="mt-[36px] grid w-full max-w-[520px] grid-cols-2 gap-y-[16px] border-t border-[#3c433d] pt-[18px] min-[681px]:mt-[42px] min-[681px]:grid-cols-4 min-[681px]:gap-y-0"
      >
        {
          siteStats.map((stat, index) => (
            <div
              class={
                index === 0
                  ? 'min-w-0'
                  : 'min-w-0 min-[681px]:border-l min-[681px]:border-[#3c433d] min-[681px]:pl-[20px]'
              }
            >
              <dt class="text-[30px] font-[800] leading-[36px] text-[#f5f7f3] min-[681px]:text-[34px] min-[681px]:leading-[41px]">
                {stat.value}
              </dt>
              <dd class="mt-[2px] text-[13px] leading-[16px] text-[#aeb7ac]">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="border-b border-[var(--yidian-border)] bg-[var(--yidian-surface)] py-[54px] min-[681px]:py-[76px]">
    <div class="mx-auto w-[calc(100%-28px)] max-w-[1180px]">
      <div
        class="flex flex-col gap-[18px] min-[681px]:flex-row min-[681px]:items-end min-[681px]:justify-between min-[681px]:gap-6"
      >
        <div>
          <p class="m-0 text-[12px] font-[800] uppercase leading-[15px] text-primary">Latest writing</p>
          <h2
            class="m-0 mt-[5px] font-heading text-[27px] font-bold leading-[35.1px] text-heading min-[681px]:text-[30px] min-[681px]:leading-[39px]"
          >
            最近发布
          </h2>
        </div>

        <a
          class="group inline-flex shrink-0 self-end items-center gap-[8px] p-0 text-[13px] font-[500] leading-[16px] text-[#aeb7ac] transition-colors hover:text-primary"
          href="https://articles.yidianhub.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="查看全部文章"
        >
          <span>查看全部文章</span>
          <Icon
            name="tabler:arrow-right"
            class="h-[16px] w-[16px] text-current transition-transform duration-150 group-hover:translate-x-0.5"
          />
        </a>
      </div>

      <div class="mt-[27px] grid grid-cols-1 gap-[14px] min-[768px]:grid-cols-3">
        {
          latestWriting.map((post, index) => (
            <article class:list={['min-w-0', { 'min-[768px]:col-span-2': index === 0 }]}>
              <a
                class:list={[
                  'group flex min-h-[236px] h-full flex-col rounded-[8px] border border-[var(--yidian-border)] px-[24px] py-[23px] transition-[border-color,transform] duration-150 hover:-translate-y-[2px] hover:border-primary min-[681px]:min-h-[252px]',
                  index === 0 ? 'bg-[#23382d]' : 'bg-[var(--yidian-surface-alt)]',
                ]}
                href={post.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={'阅读 ' + post.title}
              >
                <div class="flex items-center justify-between gap-4 text-[12px] leading-[15px] text-[var(--yidian-text-faint)]">
                  <span class="font-[800] text-primary">{post.meta}</span>
                  <time>{post.date}</time>
                </div>
                <h3
                  class:list={[
                    'm-0 mt-[26px] font-heading font-bold text-heading transition-colors duration-150 group-hover:text-primary',
                    index === 0
                      ? 'text-[27px] leading-[35.1px] min-[681px]:text-[30px] min-[681px]:leading-[39px]'
                      : 'text-[22px] leading-[28.6px]',
                  ]}
                >
                  {post.title}
                </h3>
                <p class="m-0 mt-[8px] overflow-hidden text-[14px] leading-[20px] text-[var(--yidian-text-subtle)] [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:3]">
                  {post.excerpt}
                </p>
                <span
                  class="mt-auto flex items-center justify-between pt-[20px] text-[12px] leading-[15px] text-[var(--yidian-text-faint)]"
                  aria-hidden="true"
                >
                  <span>阅读文章</span>
                  <Icon
                    name="tabler:arrow-up-right"
                    class="h-[16px] w-[16px] text-primary transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="api-service"
    class="border-b border-[var(--yidian-route-line)] bg-[var(--yidian-route-bg)] py-[54px] min-[681px]:py-[76px]"
  >
    <div
      class="mx-auto grid w-[calc(100%-28px)] max-w-[1180px] grid-cols-1 items-start gap-[38px] min-[901px]:grid-cols-[minmax(260px,0.8fr)_minmax(0,1.2fr)] min-[901px]:gap-[80px]"
    >
      <div class="min-[901px]:sticky min-[901px]:top-[130px]">
        <p class="m-0 text-[12px] font-[800] uppercase leading-[15px] text-primary">API Service</p>
        <h2
          class="m-0 mt-[5px] font-heading text-[27px] font-bold leading-[35.1px] text-heading min-[681px]:text-[30px] min-[681px]:leading-[39px]"
        >
          把模型能力，<br class="hidden min-[681px]:block" />直接接入工作流。
        </h2>
        <p class="m-0 mt-[18px] text-[16px] leading-[20px] text-[var(--yidian-nav-muted)]">
          YidianHub API
          服务为日常开发、自动化与工具连接提供统一的调用入口。选择需要的模型，在自己的应用、脚本或工作流中直接使用，减少在不同服务之间来回切换。
        </p>
      </div>
      <dl class="m-0 min-w-0 border-t border-[var(--yidian-route-line)]">
        {
          apiHighlights.map((highlight) => (
            <div class="grid grid-cols-[74px_minmax(0,1fr)] gap-[16px] border-b border-[var(--yidian-route-line)] py-[22px] min-[681px]:grid-cols-[112px_minmax(0,1fr)] min-[681px]:gap-[24px] min-[681px]:py-[25px]">
              <dt class="font-heading text-[26px] font-bold leading-[31px] text-primary min-[681px]:text-[30px] min-[681px]:leading-[36px]">
                {highlight.value}
              </dt>
              <dd class="m-0 min-w-0">
                <strong class="block text-[16px] font-bold leading-[20px] text-heading">{highlight.title}</strong>
                <p class="m-0 mt-[5px] text-[14px] leading-[18px] text-[var(--yidian-nav-muted)]">{highlight.detail}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="process" class="border-b border-[#333a35] bg-[#151714] py-[54px] min-[681px]:py-[76px]">
    <div
      class="mx-auto grid w-[calc(100%-28px)] max-w-[1180px] grid-cols-1 gap-[38px] min-[901px]:grid-cols-[440px_660px] min-[901px]:gap-[80px]"
    >
      <div>
        <p class="m-0 text-[12px] font-[800] uppercase leading-[15px] text-[#71d7a7]">Store &amp; Tools</p>
        <h2
          class="m-0 mt-[5px] font-heading text-[27px] font-bold leading-[35.1px] text-[#ecefea] min-[681px]:text-[30px] min-[681px]:leading-[39px]"
        >
          服务商品与常用工具，<br class="hidden min-[681px]:block" />按需查找与使用。
        </h2>
        <p class="m-0 mt-[18px] max-w-[440px] text-[16px] leading-[23px] text-[#a1aa9f]">
          商城集中展示当前可用的服务商品与订阅项目，清晰呈现套餐、售价、库存和联系下单方式。常用工具则持续整理适合日常工作的工具、工作流与使用说明，让需要的能力更快被找到和使用。
        </p>
      </div>
      <dl class="m-0 border-t border-[#333a35]">
        <div
          class="grid grid-cols-[74px_minmax(0,1fr)] gap-[16px] border-b border-[#333a35] py-[22px] min-[681px]:grid-cols-[112px_minmax(0,1fr)] min-[681px]:gap-[24px] min-[681px]:py-[25px]"
        >
          <dt
            class="font-heading text-[26px] font-bold leading-[31px] text-[#71d7a7] min-[681px]:text-[30px] min-[681px]:leading-[36px]"
          >
            明晰
          </dt>
          <dd class="m-0 min-w-0">
            <h3 class="m-0 text-[16px] font-bold leading-5 text-[#ecefea]">商品与服务</h3>
            <p class="m-0 mt-[5px] text-[14px] leading-[18px] text-[#a1aa9f]">
              套餐内容、售价、库存和联系下单方式集中呈现，让每一次选择都有明确的依据。
            </p>
          </dd>
        </div>
        <div
          class="grid grid-cols-[74px_minmax(0,1fr)] gap-[16px] border-b border-[#333a35] py-[22px] min-[681px]:grid-cols-[112px_minmax(0,1fr)] min-[681px]:gap-[24px] min-[681px]:py-[25px]"
        >
          <dt
            class="font-heading text-[26px] font-bold leading-[31px] text-[#71d7a7] min-[681px]:text-[30px] min-[681px]:leading-[36px]"
          >
            实用
          </dt>
          <dd class="m-0 min-w-0">
            <h3 class="m-0 text-[16px] font-bold leading-5 text-[#ecefea]">工具与方法</h3>
            <p class="m-0 mt-[5px] text-[14px] leading-[18px] text-[#a1aa9f]">
              围绕办公、写作、设计和效率等日常场景，整理可直接使用的工具、工作流与说明，帮助工作更快形成可复用的方法。
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Layout>
